# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# IMPORTANT: Replace <username> and <password> with your actual Database User credentials.
# Do NOT include the literal angle brackets `<` or `>`.
#
# URL ENCODING FOR PASSWORDS:
# If your password contains special characters, they must be URL-percent-encoded:
#   @ -> %40    # -> %23    $ -> %24    % -> %25    & -> %26    + -> %2B
#   : -> %3A    / -> %2F    ? -> %3F    = -> %3D    [ -> %5B    ] -> %5D
#
# Example (clean placeholder):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/gridshield?retryWrites=true&w=majority

# ─── DNS Configuration (Optional) ─────────────────────────────────────────────
# Custom DNS servers for SRV resolution (comma-separated).
# Useful if Node.js defaults to 127.0.0.1 on Windows or on restricted networks.
# Defaults to auto-detecting system DNS with fallback to Cloudflare/Google DNS.
# DNS_SERVERS=1.1.1.1,1.0.0.1

# ─── Frontend Origin (CORS allowlist) ─────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# Local dev example: http://localhost:3000
# Production example: https://your-app.run.app
FRONTEND_ORIGIN=http://localhost:3000

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Option A (recommended for production): Application Default Credentials
#   - On Google Cloud Run: ADC is automatic via the service account
#   - Locally: run `gcloud auth application-default login`
#   - Leave FIREBASE_SERVICE_ACCOUNT_JSON empty to use ADC

# Option B (local development without gcloud): Service Account JSON
#   - Download a service account key from Firebase Console →
#     Project Settings → Service Accounts → Generate New Private Key
#   - Set the FULL JSON content as a single-line string below
#   - NEVER commit this value; it belongs only in your local .env file
FIREBASE_SERVICE_ACCOUNT_JSON=

# Your Firebase project ID (always required)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Security ─────────────────────────────────────────────────────────────────
# Rate limit: max requests per window per IP on auth-sensitive endpoints
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
